# Copy to .env — .env is gitignored and must never be committed.
GEMINI_API_KEY=
ACCESS_CODE=
GEMINI_MODEL=gemini-2.5-flash
TTS_MODEL=gemini-2.5-flash-preview-tts

# One prebuilt Gemini voice per speaker. A wrong name is not fatal — the
# client falls back to the browser's own synthesis.
# Axel uses Zubenelgenubi: the voice jailbreak-camera gives its teenage punk.
VOICE_AXEL=Zubenelgenubi
VOICE_BOUNCER=Charon
VOICE_BARTENDER=Aoede
VOICE_LEARNER=Leda

# Delivery instruction per speaker. Gemini TTS reads a leading "Say X:" as
# direction rather than as words to speak — this is how a prebuilt voice gets
# steered without SSML. Defaults are in server.js; override only to retune.
# STYLE_AXEL=
# STYLE_BOUNCER=
# STYLE_BARTENDER=
# STYLE_LEARNER=

# Set MOCK=1 to run with the local deterministic matcher and make no API calls.
# It is also the automatic behaviour when GEMINI_API_KEY is empty.
MOCK=1
